# =======================
# Stage 1: Builder
# =======================
FROM ubuntu:22.04 AS builder

# Avoid prompts during apt operations
ENV DEBIAN_FRONTEND=noninteractive

# Build-time environment variables
ENV JAVA_HOME=/usr/lib/jvm/java-19-openjdk-amd64
ENV GOPATH=/root/go
ENV PATH="$JAVA_HOME/bin:/usr/local/go/bin:/usr/local/bin:$PATH"

# Install core build dependencies
RUN apt-get update && apt-get install -y \
    sudo \
    git \
    curl \
    wget \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# -------------------- OPENJDK 19 SETUP --------------------
RUN mkdir -p /usr/lib/jvm \
    && curl -fSL "https://github.com/adoptium/temurin19-binaries/releases/download/jdk-19.0.2%2B7/OpenJDK19U-jdk_x64_linux_hotspot_19.0.2_7.tar.gz" -o /tmp/openjdk.tar.gz \
    && tar -xzf /tmp/openjdk.tar.gz -C /usr/lib/jvm \
    && rm /tmp/openjdk.tar.gz \
    && mv /usr/lib/jvm/jdk-19.0.2+7 $JAVA_HOME \
    && rm -rf $JAVA_HOME/lib/src.zip $JAVA_HOME/man $JAVA_HOME/docs

# -------------------- MAVEN SETUP --------------------
RUN mkdir -p /opt/maven \
    && curl -fSL --retry 5 --retry-delay 5 --connect-timeout 60 "https://dlcdn.apache.org/maven/maven-3/3.9.12/binaries/apache-maven-3.9.12-bin.tar.gz" -o /tmp/maven.tar.gz \
    && tar -xzf /tmp/maven.tar.gz -C /opt/maven --strip-components=1 \
    && rm /tmp/maven.tar.gz \
    && ln -s /opt/maven/bin/mvn /usr/local/bin/mvn \
    && rm -rf /opt/maven/bin/*.cmd /opt/maven/lib/maven-artifact.jar.asc

# -------------------- GRADLE SETUP --------------------
RUN curl -fSL "https://services.gradle.org/distributions/gradle-8.5-bin.zip" -o /tmp/gradle.zip \
    && unzip /tmp/gradle.zip -d /opt \
    && rm /tmp/gradle.zip \
    && ln -s /opt/gradle-8.5/bin/gradle /usr/local/bin/gradle \
    && rm -rf /opt/gradle-8.5/docs /opt/gradle-8.5/samples /opt/gradle-8.5/media

# -------------------- NODE.JS + NPM + CDXGEN --------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g @cyclonedx/cdxgen

# -------------------- UV SETUP (GLOBAL) --------------------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx \
    && chmod +x /usr/local/bin/uv /usr/local/bin/uvx

# -------------------- GO 1.24.4 SETUP --------------------
RUN curl -fSL https://go.dev/dl/go1.24.4.linux-amd64.tar.gz -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && rm -rf /usr/local/go/pkg/obj /usr/local/go/pkg/bootstrap /usr/local/go/test /usr/local/go/doc /usr/local/go/api

# -------------------- GO TOOLS SETUP --------------------
RUN go install github.com/vc60er/deptree@latest \
    && go install github.com/CycloneDX/cyclonedx-gomod/cmd/cyclonedx-gomod@latest \
    && ln -sf $GOPATH/bin/deptree /usr/local/bin/deptree \
    && ln -sf $GOPATH/bin/cyclonedx-gomod /usr/local/bin/cyclonedx-gomod

# -------------------- COLLECT GIT LIBRARIES --------------------
RUN mkdir -p /git-libs \
    && ldd /usr/bin/git /usr/lib/git-core/git-remote-https | grep "=> /" | awk '{print $3}' | sort -u | xargs -I {} cp -v {} /git-libs/

# -------------------- WORKSPACE --------------------
WORKDIR /workspace

# Copy dependency files first for caching
COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project

# Copy application code
COPY . /workspace
RUN uv sync

# =======================
# Stage 2: Runtime
# =======================
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/usr/lib/jvm/java-19-openjdk-amd64
ENV PATH="/workspace/.venv/bin:$JAVA_HOME/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:$PATH"

WORKDIR /workspace

# Install runtime-only essentials
RUN apt-get update && apt-get install -y \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# -------------------- Maven --------------------
COPY --from=builder /opt/maven /opt/maven
RUN ln -s /opt/maven/bin/mvn /usr/local/bin/mvn

# -------------------- Git --------------------
COPY --from=builder /usr/bin/git /usr/bin/git
COPY --from=builder /usr/lib/git-core /usr/lib/git-core
COPY --from=builder /usr/share/git-core /usr/share/git-core
COPY --from=builder /git-libs/* /usr/lib/x86_64-linux-gnu/

# Copy Java
COPY --from=builder /usr/lib/jvm /usr/lib/jvm

# Copy Gradle
COPY --from=builder /opt/gradle-8.5 /opt/gradle-8.5
RUN ln -s /opt/gradle-8.5/bin/gradle /usr/local/bin/gradle

# Copy Go
COPY --from=builder /usr/local/go /usr/local/go

# Copy Go Tools
COPY --from=builder /root/go/bin/deptree /usr/local/bin/deptree
COPY --from=builder /root/go/bin/cyclonedx-gomod /usr/local/bin/cyclonedx-gomod

# Copy Node.js and NPM
COPY --from=builder /usr/bin/node /usr/bin/node
COPY --from=builder /usr/lib/node_modules /usr/lib/node_modules
RUN ln -sf /usr/lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm \
    && ln -sf /usr/lib/node_modules/@cyclonedx/cdxgen/bin/cdxgen.js /usr/bin/cdxgen \
    && chmod +x /usr/bin/cdxgen

# Copy UV
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /usr/local/bin/uvx /usr/local/bin/uvx

# Copy Application and Venv
COPY --from=builder /workspace/.venv /workspace/.venv
COPY --from=builder /workspace/main.py /workspace/main.py
COPY --from=builder /workspace/both_supports /workspace/both_supports

# Command to run the application
CMD ["python3", "main.py"]
